# Copy to backend/.env and adjust. NEVER commit the real .env.
ENVIRONMENT=development
# psycopg 3 driver. Docker dev DB from infra/docker-compose.yml listens on host port 5433.
DATABASE_URL=postgresql+psycopg://iglesia:iglesia_dev_password@localhost:5433/iglesia
# Used only by the pytest suite (separate database, wiped on every run).
TEST_DATABASE_URL=postgresql+psycopg://iglesia:iglesia_dev_password@localhost:5433/iglesia_test
# REQUIRED (the app refuses to start without it, or with an example/placeholder value).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Comma separated list of allowed browser origins (web ordering site).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Private directory for uploaded payment proofs (never served statically).
STORAGE_DIR=./storage_private
# Optional: store payment proofs in Cloudinary (private) instead of STORAGE_DIR.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>  (Cloudinary dashboard -> API Keys)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=iglesia/comprobantes
MAX_UPLOAD_BYTES=5242880
MAX_PENDING_PROOFS_PER_ORDER=3
DEFAULT_TIMEZONE=America/Bogota
RATE_LIMIT_ENABLED=true
# Set to true only when running behind your own reverse proxy that APPENDS to X-Forwarded-For.
# The client IP is then the TRUSTED_PROXY_HOPS-th entry from the RIGHT (leftmost entries are spoofable).
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
# Stored idempotent responses are deleted after this many hours by a background task (0 = no task).
IDEMPOTENCY_RETENTION_HOURS=48
IDEMPOTENCY_PURGE_INTERVAL_MINUTES=60
DUPLICATE_ORDER_WINDOW_SECONDS=120
# Public URL of the customer web menu (QR: python -m app.cli qr, see docs/QR.md).
PUBLIC_WEB_URL=http://localhost:5173
